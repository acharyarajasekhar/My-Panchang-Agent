# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file with real secrets to version control

# ─────────────────────────────────────────────────────────────────────
# Slack Configuration
# ─────────────────────────────────────────────────────────────────────

# Slack Incoming Webhook URL for posting Panchangam messages
# Get this from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_TEAM_ID/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_SECRET

# Slack App Signing Secret for verifying requests from Slack
# Get this from: https://api.slack.com/apps/ → Your App → Basic Information
SLACK_SIGNING_SECRET=your_slack_app_signing_secret_here

# ─────────────────────────────────────────────────────────────────────
# GitHub Configuration
# ─────────────────────────────────────────────────────────────────────

# GitHub Personal Access Token for triggering workflows
# Create from: https://github.com/settings/tokens
# Requires: repo (full control of private repositories) scope
PANCHANG_GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# GitHub token for Cloudflare Worker (same as above or different token)
# Used by the Cloudflare Worker to dispatch GitHub Actions
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ─────────────────────────────────────────────────────────────────────
# Cloudflare Worker Configuration
# ─────────────────────────────────────────────────────────────────────

# Cloudflare Worker URL for local testing
# Default: http://localhost:8787 (when running `wrangler dev`)
# Production: https://your-worker-name.your-subdomain.workers.dev
WORKER_URL=http://localhost:8787

# Production worker URL (optional, for test scripts)
WORKER_URL_PROD=https://panchang-slack-bridge.workers.dev

# GitHub repository owner and name (used by Cloudflare Worker)
# Update if you fork the repository
GITHUB_OWNER=your_github_username
GITHUB_REPO=My-Panchang-Agent

# GitHub event type for workflow dispatch
GITHUB_EVENT_TYPE=panchang-webhook

# ─────────────────────────────────────────────────────────────────────
# Optional: Development Settings
# ─────────────────────────────────────────────────────────────────────

# Message language(s): "english", "telugu", or both separated by comma
# MESSAGE_LANGUAGE=english,telugu

# Debug logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
