# Cloudflare Environment Variables
# Copy to .env.local and fill in your actual values

# GitHub Configuration
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your_github_username
GITHUB_REPO=My-Panchang-Agent
GITHUB_EVENT_TYPE=panchang-webhook

# Slack Configuration
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: Slack Bot Token (for interactive responses)
SLACK_BOT_TOKEN=xoxb_your_bot_token_here

# Environment
ENVIRONMENT=development
